{
  "manifest_version": 3,
  "name": "AI Tools Usage Collector",
  "description": "Collects AI provider usage from authenticated browser sessions and sends structured payloads to Home Assistant.",
  "version": "0.1.0",
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "AI Tools Usage"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://ollama.com/*",
    "https://www.ollama.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
