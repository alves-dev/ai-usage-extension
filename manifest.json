{
  "manifest_version": 3,
  "name": "AI Usage Collector",
  "description": "Collects AI provider usage from authenticated browser sessions and sends structured payloads to Home Assistant.",
  "version": "0.2.0",
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "AI Usage"
  },
  "icons": {
    "16":  "icons/icon_16x16.png",
    "32":  "icons/icon_32x32.png",
    "48":  "icons/icon_48x48.png",
    "128": "icons/icon_128x128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://ollama.com/*",
    "https://www.ollama.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
